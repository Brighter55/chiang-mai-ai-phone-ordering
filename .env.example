DJANGO_SECRET_KEY=change-me-to-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Deepgram Voice Agent API — STT + LLM + TTS in one managed WebSocket
DEEPGRAM_API_KEY=...
# STT model: nova-3-general (default, supports keyterm biasing),
#            flux-general-en (native turn-taking, no keyterms)
DEEPGRAM_VOICE_AGENT_STT_MODEL=nova-3-general
# LLM model (hosted by Deepgram)
DEEPGRAM_VOICE_AGENT_LLM_MODEL=gpt-4o-mini
# TTS voice (Deepgram Aura)
DEEPGRAM_VOICE_AGENT_TTS_MODEL=aura-asteria-en
# LLM temperature — 0 = deterministic
DEEPGRAM_VOICE_AGENT_TEMPERATURE=0

# Twilio (Voice + SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Where to send order SMS notifications
RESTAURANT_PHONE=+1...

# Database (PostgreSQL)
DB_NAME=chiang_mai_ai
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional
RESTAURANT_NAME=My Restaurant
