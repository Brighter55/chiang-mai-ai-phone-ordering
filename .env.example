DJANGO_SECRET_KEY=change-me-to-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Deepgram Voice Agent API — STT + LLM + TTS in one managed WebSocket
DEEPGRAM_API_KEY=...
# STT model: nova-3-general (default, supports keyterm biasing),
#            flux-general-en (native turn-taking, no keyterms)
DEEPGRAM_VOICE_AGENT_STT_MODEL=nova-3-general
# LLM model (hosted by Deepgram)
DEEPGRAM_VOICE_AGENT_LLM_MODEL=gpt-4o-mini
# TTS voice (Deepgram Aura)
DEEPGRAM_VOICE_AGENT_TTS_MODEL=aura-asteria-en
# LLM temperature — 0 = deterministic
DEEPGRAM_VOICE_AGENT_TEMPERATURE=0

# Twilio (Voice + SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Where to send order SMS notifications
RESTAURANT_PHONE=+1...

# Optional: transfer-to-human destination (E.164, e.g. +1XXXXXXXXXX).
# Leave empty to disable transfers. Must be a DIRECT line — NOT
# RESTAURANT_PHONE (its AT&T no-answer forwarding would bounce the call back
# into the AI) and NOT TWILIO_PHONE_NUMBER.
TRANSFER_PHONE=

# Database (PostgreSQL)
DB_NAME=chiang_mai_ai
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional
RESTAURANT_NAME=My Restaurant

# Clover POS — menu source of truth + AI places orders here as open "Take out" tickets
CLOVER_MERCHANT_ID=...
# Long-lived merchant API token (API Access → Generate Token in the Clover dashboard)
CLOVER_API_TOKEN=...
# Production: https://api.clover.com | Sandbox: https://apisandbox.dev.clover.com
CLOVER_BASE_URL=https://api.clover.com
# Name of the order type used for AI phone orders (must exist in the merchant)
CLOVER_ORDER_TYPE_NAME=Take out
# Optional hardcoded order-type id — bypasses the /order_types lookup, which some
# API tokens can't read (401). Find the id in the dashboard URL for that order type.
CLOVER_ORDER_TYPE_ID=
