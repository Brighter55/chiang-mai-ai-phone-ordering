DJANGO_SECRET_KEY=change-me-to-random-string
DEBUG=True
ALLOWED_HOSTS=*

# OpenAI
OPENAI_API_KEY=sk-...

# Deepgram (Speech-to-Text)
DEEPGRAM_API_KEY=...

# Twilio (Voice + SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Where to send order SMS notifications
RESTAURANT_PHONE=+1...

# Database (PostgreSQL)
DB_NAME=chiang_mai_ai
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional
RESTAURANT_NAME=My Restaurant

# TTS (Text-to-Speech) — Deepgram voice model
# Models: aura-2-odysseus-en, aura-asteria-en, aura-orion-en, aura-stella-en, aura-luna-en, etc.
DEEPGRAM_TTS_MODEL=aura-asteria-en
DEEPGRAM_TTS_RATE=1.2
